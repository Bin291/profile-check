# ── Backend (server/index.ts) — set these on Render ─────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16char_app_password
# Cloudflare frontend URL(s), comma-separated. e.g. https://my-profile.pages.dev
ALLOWED_ORIGINS=

# ── Frontend (Vite) — set on Cloudflare Pages ───────────────────────────────
# Backend URL on Render. Leave empty for local dev (uses Vite proxy).
VITE_API_URL=
