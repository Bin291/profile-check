# Set these in the Cloudflare Pages project (Settings → Variables) AND in local .env.

# Resend API key — https://resend.com/api-keys (sends over HTTPS; runs in Cloudflare Functions)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where contact messages arrive (your inbox)
CONTACT_TO=binhnguyen290104@gmail.com
# Sender. Use onboarding@resend.dev until you verify binhh.id.vn in Resend,
# then switch to e.g. "Portfolio <noreply@binhh.id.vn>"
RESEND_FROM=Portfolio <onboarding@resend.dev>

# Frontend: leave empty so the form calls /api/contact on the same domain
# (Vite proxy → local Express in dev; Cloudflare Function in production).
VITE_API_URL=
