# ── Backend (server/index.ts) — set these on Render ─────────────────────────
# Resend API key — https://resend.com/api-keys  (sends over HTTPS, works on Render free)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where contact messages arrive (your inbox)
CONTACT_TO=binhnguyen290104@gmail.com
# Sender. Use onboarding@resend.dev until you verify binhh.id.vn in Resend,
# then switch to e.g. "Portfolio <noreply@binhh.id.vn>"
RESEND_FROM=Portfolio <onboarding@resend.dev>
# Cloudflare frontend URL(s), comma-separated. e.g. https://www.binhh.id.vn,https://binhh.id.vn
ALLOWED_ORIGINS=

# ── Frontend (Vite) — set on Cloudflare ─────────────────────────────────────
# Backend URL on Render. Leave empty for local dev (uses Vite proxy).
VITE_API_URL=
